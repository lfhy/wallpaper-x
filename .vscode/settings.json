{
  // ========== 1. 核心：禁止扫描缓存/垃圾目录（降CPU关键） ==========
  "files.exclude": {
    "**/.git": false, // 保留.git目录（GitHub仓库管理必需）
    "**/.DS_Store": true,
    "**/build": true,
    "**/DerivedData": true,
    "**/xcuserdata": true,
    "**/*.xcuserstate": true,
    "**/node_modules": true,
    "**/Pods": true,
    "**/*.xcarchive": true, // 合并Xcode归档文件排除（解决重复键）
    "**/*.dSYM": true // 合并调试符号文件排除
  },
  "search.exclude": {
    "**/build": true,
    "**/DerivedData": true,
    "**/xcuserdata": true,
    "**/.git/objects": true // 只排除git大文件，保留git核心目录
  },
  "files.watcherExclude": {
    "**/build/**": true,
    "**/DerivedData/**": true,
    "**/xcuserdata/**": true,
    "**/.git/objects/**": true
  },

  // ========== 2. 适配Codex + Swift开发（保留核心功能） ==========
  "editor.quickSuggestions": { // Codex补全必需
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.acceptSuggestionOnEnter": "off", // 避免误触Codex补全
  "swift.enableServerDiagnostics": false, // 关闭Swift实时检查（降功耗）
  "swift.formatOnType": false,
  // 注释掉sourcekit-lsp路径（避免路径错误，让插件自动识别）
  // "swift.path.sourcekit-lsp": "/Applications/Xcode.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin/sourcekit-lsp",

  // ========== 3. 适配GitHub仓库管理（保留核心Git功能） ==========
  "git.enableSmartCommit": true, // 智能提交（适配仓库快照）
  "git.autofetch": false, // 关闭自动拉取（降功耗）
  "git.confirmSync": true, // 同步前确认（避免误操作）
  "git.defaultCloneDirectory": "~/Documents/GitHub", // 自定义GitHub克隆目录（macOS适配）

  // ========== 4. 低功耗优化（macOS专属） ==========
  "files.autoSave": "afterDelay", // macOS友好的延迟保存（避免频繁读写）
  "editor.formatOnType": false,
  "editor.formatOnSave": false,
  "workbench.startupEditor": "none",
  "editor.minimap.enabled": false,
  "telemetry.telemetryLevel": "off", // 关闭遥测
  "extensions.ignoreRecommendations": true,
  "terminal.integrated.defaultProfile.osx": "zsh", // 适配macOS默认终端
  "files.eol": "\n", // macOS换行符（避免跨平台问题）

  // ========== 5. Swift壁纸开发专属优化 ==========
  "files.associations": { // 关联SwiftUI/壁纸开发相关文件
    "*.swiftui": "swift",
    "*.xcassets": "json",
    "*.plist": "xml"
  },
  "editor.rulers": [120] // Swift代码行宽限制（适配macOS开发规范）
}